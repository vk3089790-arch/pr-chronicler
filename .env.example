# ==============================================================================
# PR Chronicler Environment Configuration
# Copy this file to .env and populate with your credentials.
# NEVER commit your actual .env file with secrets to source control.
# ==============================================================================

# Google Gemini LLM API
# Obtain from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=AIzaSyYourGeminiApiKeyHere

# Gemini Model Identifier
# Compatible models: gemini-2.5-flash, gemini-2.5-pro, gemini-flash-latest
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.1

# GitHub REST API & Webhooks
# Personal access token with 'repo' or 'public_repo' scope (increases rate limit from 60 to 5,000/hr)
GITHUB_TOKEN=ghp_YourGitHubPersonalAccessToken

# GitHub Webhook HMAC Secret (configured in repository webhook settings under 'Secret')
# When provided, incoming webhooks MUST include matching X-Hub-Signature-256 header.
GITHUB_WEBHOOK_SECRET=your_super_secret_webhook_key_here

# SMTP Email Configuration
# Example below configured for Gmail (requires an App Password with 2FA enabled)
SMTP_EMAIL=your_sending_account@gmail.com
SMTP_APP_PASSWORD=your_16_character_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

# Recipient Email for PR Reflection Reports
RECIPIENT_EMAIL=your_destination_inbox@example.com

# Persistence & Logging
DATABASE_PATH=pr_chronicler.db
LOG_FILE=pr_chronicler.log
LOG_LEVEL=INFO

# Webhook Server
HOST=0.0.0.0
PORT=8000
